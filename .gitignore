*.glb
*.gltf
*.fbx
*.obj
*.stl
*.blend
*.blend[0-9]
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf

# --- кэши генерации и рендера ------------------------------------------------
.comfyui/
comfyui-output/
**/ae-cache/
**/*.aecache

# --- node / typescript -------------------------------------------------------
node_modules/
dist/
build/
*.tsbuildinfo

# --- prisma ------------------------------------------------------------------
# Клиент генерируется из схемы на postinstall, локальная база не коммитится.
/cartoon-engine/packages/core/generated/
*.db
*.db-journal
*.db-shm
*.db-wal

# --- окружение ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- ОС и редакторы ----------------------------------------------------------
desktop.ini
Thumbs.db
.DS_Store
.vscode/
.idea/
