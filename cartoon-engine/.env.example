# Корень медиа. Все относительные пути в базе считаются от него.
#
# Значения по умолчанию у этой переменной нет намеренно. Неверный корень не
# сломает импорт — он молча зарегистрирует не то дерево, и обнаружится это
# гораздо позже. Лучше понятный отказ на старте.
#
# Сейчас корень совпадает с корнем репозитория: медиа лежит внутри него, но в
# git не попадает (см. .gitignore). Путь абсолютный.
MEDIA_ROOT="C:/Users/yanis/мои проекты/cartoon"

# Локальная база движка. Файл в .gitignore.
DATABASE_URL="file:./engine.db"

# Локальный ComfyUI. Адрес обязан быть локальным: провайдер отказывается
# работать с удалённым, потому что это означало бы внешний сервис.
COMFYUI_BASE_URL="http://127.0.0.1:8188"
# Корень установки — по нему проверяется наличие весов на диске.
COMFYUI_INSTALL_ROOT="C:/AI/ComfyUI"
# API-workflow с LoRA ракурсов. Файл из самой установки, не наш.
COMFYUI_WORKFLOW="C:/AI/ComfyUI/workflows_api/04_multiview_qwen.json"
