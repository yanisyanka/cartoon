// Модель хранения Cartoon Engine.
//
// В этой задаче (CE-TASK-001) сущностей ровно две: Asset и Provenance.
// Job, Take, Spend, Verdict и остальное из утверждённой архитектуры появятся
// своими миграциями, когда за ними встанет работающий код, — не раньше.
//
// Провайдер sqlite: один пользователь, один проект, файл на диске.

generator client {
  provider = "prisma-client"
  output   = "../packages/core/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Файл, зарегистрированный в системе.
///
/// Байты сюда не копируются и отсюда не читаются: в базе живут только адрес и
/// отпечаток. Физический файл остаётся ровно там, где лежал, и работа с ним
/// идёт исключительно через MediaStore.
model Asset {
  id String @id @default(cuid())

  /// Путь относительно MEDIA_ROOT, всегда через прямой слэш.
  /// Абсолютных путей в базе нет намеренно: корень медиа может переехать, а
  /// строки должны это пережить.
  relativePath String @unique

  /// Грубый вид: image | video | audio | project | unknown.
  /// По нему на следующих фазах будут выбираться проверки качества —
  /// силуэт и цвет-якорь применимы к картинке и бессмысленны для звука.
  type String

  /// Точный тип, определённый ПО СОДЕРЖИМОМУ, а не по расширению.
  /// Расширение — это утверждение файловой системы, и оно бывает ложным.
  mimeType String

  /// Размер в байтах.
  ///
  /// Int, а не BigInt: предел 2,1 ГБ, а самый крупный эталон — 26 МБ. BigInt
  /// стоил бы сегодня реальной боли (JSON.stringify на нём падает, а отчёты
  /// проверок печатают JSON) ради случая, которого пока нет. Когда появятся
  /// мастера видео, переход будет пустым: SQLite хранит INTEGER восемью
  /// байтами независимо от того, что о колонке думает Prisma.
  sizeBytes Int

  /// Отпечаток содержимого. Одновременно ключ дедупликации и проверка
  /// целостности: тот же файл, зарегистрированный второй раз, опознаётся
  /// именно здесь, а не по пути.
  sha256 String @unique

  createdAt DateTime @default(now())

  provenance Provenance?

  @@map("assets")
}

/// Происхождение ассета: откуда взялись байты и можно ли получить их снова.
///
/// Отдельная сущность, а не поля в Asset. Причина в разной скорости роста: имя,
/// размер и отпечаток файла — это исчерпывающий и законченный набор, тогда как
/// происхождение на следующих фазах обрастёт моделью, seed, параметрами
/// запроса, входными ассетами и отпечатком окружения. Смешав их, мы получили бы
/// таблицу, где половина колонок пуста у половины строк.
///
/// Ровно одно происхождение на ассет: файл создаётся один раз. Переделанный
/// файл — это другие байты, другой sha256 и, значит, другой Asset.
model Provenance {
  id      String @id @default(cuid())
  assetId String @unique

  /// Кто произвёл байты: import | provider | human.
  producedBy String

  /// Можно ли получить эти байты снова:
  /// unknown | deterministic | stochastic | human-touched.
  ///
  /// Значение вычисляет система по фактам, а не объявляет производитель.
  /// Провайдер, называющий себя воспроизводимым, — это ровно тот вид
  /// самоаттестации, который ничего не стоит.
  reproducibility String

  /// Почему происхождение именно такое. Для импорта — что именно неизвестно.
  note String?

  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("provenances")
}
