// Модель хранения Cartoon Engine.
//
// CE-TASK-001 завёл Asset и Provenance. CE-TASK-002 добавляет предметный слой:
// кто изображён (Character), чем является файл (Asset.role), какая это версия
// (supersedes) и по каким правилам это проверяется (CanonRule).
//
// Job, Take, Spend и остальное из утверждённой архитектуры появятся своими
// миграциями, когда за ними встанет работающий код, — не раньше.
//
// Провайдер sqlite: один пользователь, один проект, файл на диске.

generator client {
  provider = "prisma-client"
  output   = "../packages/core/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Файл, зарегистрированный в системе.
///
/// Байты сюда не копируются и отсюда не читаются: в базе живут только адрес и
/// отпечаток. Физический файл остаётся ровно там, где лежал, и работа с ним
/// идёт исключительно через MediaStore.
model Asset {
  id String @id @default(cuid())

  /// Путь относительно MEDIA_ROOT, всегда через прямой слэш и в том регистре,
  /// в каком файл записан на диске (канонизация через realpath.native).
  ///
  /// Уникальным этот путь больше НЕ является: у одного пути живёт история
  /// версий. Уникальна пара путь+версия.
  relativePath String

  /// Грубый вид: image | video | audio | project.
  type String

  /// Точный тип, определённый ПО СОДЕРЖИМОМУ, а не по расширению.
  mimeType String

  /// Размер в байтах. Int: предел 2,1 ГБ, крупнейший эталон — 26 МБ.
  /// Переход на BigInt будет пустой миграцией — SQLite хранит INTEGER
  /// восемью байтами независимо от того, что о колонке думает Prisma.
  sizeBytes Int

  /// Отпечаток содержимого. Уникален глобально: одни и те же байты — это
  /// один ассет, где бы они ни лежали.
  sha256 String @unique

  /// Чем файл является: ref-front | turnaround | emotion-still | plate |
  /// storyboard | render | other.
  ///
  /// null — «ещё не классифицирован», и это отдельное от 'other' состояние.
  /// Именно в нём находились десять эталонов после CE-TASK-001, и заменять
  /// его на 'other' значило бы выдать незнание за решение.
  role String?

  /// Кто изображён. null — файл не привязан к персонажу (фон, титр, сборка).
  characterId String?

  /// Номер версии по этому пути, начиная с 1.
  version Int @default(1)

  /// Предыдущая версия по тому же пути. null у первой.
  ///
  /// Направление ссылки выбрано так, что старая строка при появлении новой НЕ
  /// изменяется вовсе: новая указывает на старую, а не наоборот. Прошлое
  /// остаётся ровно таким, каким было записано.
  supersedesId String? @unique

  createdAt DateTime @default(now())

  provenance   Provenance?
  character    Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)
  supersedes   Asset?      @relation("AssetVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy Asset?      @relation("AssetVersions")

  @@unique([relativePath, version])
  @@index([relativePath])
  @@index([characterId, role])
  @@map("assets")
}

/// Происхождение ассета: откуда взялись байты и можно ли получить их снова.
///
/// Отдельная сущность, а не поля в Asset: имя, размер и отпечаток файла —
/// законченный набор, тогда как происхождение на следующих фазах обрастёт
/// моделью, seed, параметрами запроса и отпечатком окружения.
///
/// Ровно одно происхождение на ассет. Переделанный файл — это другие байты,
/// другой sha256 и, значит, другой Asset со своим происхождением.
model Provenance {
  id      String @id @default(cuid())
  assetId String @unique

  /// Кто произвёл байты: import | provider | human.
  producedBy String

  /// Можно ли получить эти байты снова:
  /// unknown | deterministic | stochastic | human-touched.
  /// Значение вычисляет система по фактам, а не объявляет производитель.
  reproducibility String

  note String?

  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("provenances")
}

/// Дух из канона MOSSKIN.
///
/// Здесь только то, что нужно движку: строка промпта, якоря, рост. Канон
/// целиком остаётся в `characters/<slug>/character.md` — база это его
/// производная, а не замена. Поэтому рядом лежит отпечаток паспорта: по нему
/// видно, из какой версии markdown строка получена и не разошлись ли они.
model Character {
  id String @id @default(cuid())

  /// Имя каталога: '01-mossy'. Оно же связывает персонажа с его файлами.
  slug String @unique

  /// Номер в кодексе, 1..10.
  number Int @unique

  /// Латиницей — то, что уходит в промпты и имена файлов.
  name String

  /// По-русски — то, что видит человек.
  nameRu String

  /// Должность из паспорта.
  title String

  /// Строка для промпта. Копируется ДОСЛОВНО и никогда не редактируется кодом:
  /// в паспорте прямо написано «копировать дословно», и любая нормализация
  /// увела бы генерацию от эталона.
  promptLine String

  /// Цвета-якоря, JSON-массив: ["#4A5D3A","#C43B2E"].
  /// Массивов в SQLite нет, а отдельная таблица ради двух значений на строку
  /// стоила бы дороже, чем даёт.
  colorAnchors String

  /// Рост относительно Москина (он — 1.0).
  heightRatio Float

  /// Частота появления: постоянный | второстепенный | редкий.
  frequency String

  /// Паспорт, из которого всё это прочитано.
  sourcePath   String @unique
  /// Отпечаток паспорта на момент импорта: разошлись ли база и канон.
  sourceSha256 String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]

  @@map("characters")
}

/// Правило канона как данные.
///
/// Проверок здесь нет и на этом этапе не будет: сначала правила должны стать
/// перечислимыми и адресуемыми, и только потом за ними встанет код. Источник
/// каждого правила — раздел CAST.md, и он указан явно, чтобы формулировку
/// всегда можно было сверить с оригиналом.
model CanonRule {
  id String @id @default(cuid())

  /// Машинный код: 'color-anchor-red-belongs-to-fungi'.
  code String @unique

  /// Формулировка человеку. Перенесена из CAST.md, не переписана.
  description String

  /// blocking | warning.
  severity String

  enabled Boolean @default(true)

  /// Откуда правило взято: 'characters/CAST.md § Правила, которые нельзя нарушать, п.1'.
  source String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("canon_rules")
}
